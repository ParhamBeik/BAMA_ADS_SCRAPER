# Copy to .env. Compose reads it; so does deploy/worker.sh under host cron.
#
# Every variable config/settings.py reads is listed here, with the default it
# falls back to when the line is absent. Production has its own file with its own
# values — see deploy/.env.production.example.

# --- Django ---------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret-key
# Unset (or anything other than 1) means the hardened profile: HTTPS redirect,
# HSTS, throttles, login required. A deployed process must never fail open.
DJANGO_DEBUG=1
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Who may POST. Separate from CORS_ORIGINS on purpose — that one says who may
# *read* a response — and it is the one that bites: Django checks the browser's
# Origin header on every unsafe request, and the Vite proxy rewrites Host but
# not Origin, so a frontend on any other port is refused with
# "CSRF Failed: Origin checking failed" while every GET still works. If you move
# the dev server off 5173, move this with it.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# 1 makes every read endpoint AllowAny. Local tooling only — unset it and the
# catalogue requires a login, which is what a deployed instance does.
API_PUBLIC_READS=1

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=bama_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-side DSN. Port 5433, not 5432: a native PostgreSQL install usually owns
# 5432, and pointing here at it would make host-run manage.py commands hit that
# unrelated server. There is one bama_saas database — this one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bama_saas
# Host port compose publishes Postgres on; must match the port above. The
# container-internal port is always 5432.
POSTGRES_HOST_PORT=5433
FRONTEND_HOST_PORT=5174

# --- Redis ----------------------------------------------------------------
# Cache only: proxied listing photos and the deal board's computed window. Both
# are derived data, so losing the whole cache costs one recomputation. Empty
# under DJANGO_DEBUG selects LocMem, which is why the tests need no Redis — but
# a per-process cache in a multi-worker stack is indistinguishable from none.
REDIS_URL=redis://redis:6379/0
# Bama's image URLs are content-addressed, so a stale entry cannot be wrong.
IMAGE_CACHE_SECONDS=2592000
# Listing photos run ~40-120KB. Past this it is not a car photo.
IMAGE_MAX_BYTES=2097152

# --- Auth, throttling, proxies --------------------------------------------
# Session lifetime in seconds (14 days, sliding on activity).
SESSION_COOKIE_AGE=1209600
# How many proxies sit in front of Django, and the difference between a
# brute-force guard and a decoration. Left unset, DRF buckets throttles on the
# whole X-Forwarded-For string — which the caller can write. 2 is the deployed
# chain (Caddy, then the frontend nginx). Only change it if the chain changes.
NUM_PROXIES=2
# Per resolved client IP. Sized for a room, not for one attacker: a group behind
# one office NAT shares a public address. Never set these to an empty value — an
# env var that is present and empty beats the default and hands DRF an
# unparseable rate. Anon and user rates apply only when DJANGO_DEBUG is off.
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_PASSWORD=5/min
THROTTLE_ANON=60/min
THROTTLE_USER=600/min

# --- Accounts -------------------------------------------------------------
# There are none to configure. Nothing is seeded: sign up through the UI. Every
# signup is a regular user — staff comes from `manage.py createsuperuser` or
# Django admin, never from being first through the door. A password living in an
# env var is a credential nobody rotates and every deploy operator can read.
# `manage.py wipe_users --yes` clears the table if you need to start over.

# --- Crawler --------------------------------------------------------------
BAMA_MAX_ADS=50000
# 1.5s, not 0.8s: bama.ir answered 503 to 55 runs over 39 days. A slower crawl
# that completes is worth more than a fast one whose coverage cannot be proven.
BAMA_PAGE_PAUSE=1.5
BAMA_REQUEST_TIMEOUT=20
BAMA_COOKIE=
# Per-tick fetch ceiling — a backstop, NOT the intended stop, which is
# `max_stale_pages`. 1500, not 500: at 500 it was the routine stop, ending 365
# delta runs on max_ads against 228 on stale_pages over one week — the
# saturation rule pre-empted 62% of the time, the crawl walking away from a feed
# that was still yielding new ads.
BAMA_WORKER_FETCH_ADS=1500
BAMA_COVERAGE_CHUNK_PAGES=120
# Episodes that started before this date have untrustworthy end dates and are
# excluded from survival analysis. Set it to the date rolling coverage went live.
BAMA_EPISODE_CLEAN_START=2026-08-14
# How many bargain-board detail pages one probe_sold tick may visit.
BAMA_SOLD_PROBE_ADS=20

# --- Crawl-gate cooldowns (seconds) ---------------------------------------
# Blocked: bama.ir answered 403 (WAF). One pipeline tick, then doubling to 6h.
BAMA_BLOCK_COOLDOWN=900
BAMA_BLOCK_COOLDOWN_MAX=21600
# Failing rather than refusing. Capped below one hot tick, so recovery costs at
# most one missed fetch.
BAMA_UPSTREAM_COOLDOWN=120
BAMA_UPSTREAM_COOLDOWN_MAX=600

# --- Worker and training loops (seconds) ----------------------------------
BAMA_HOT_EVERY=900
BAMA_COVERAGE_EVERY=600
BAMA_WARM_EVERY=1800
BAMA_MAINTENANCE_EVERY=21600
BAMA_HEARTBEAT=30
BAMA_WORKER_HEARTBEAT=/tmp/bama-worker.ok
# Daily, not hourly: the promotion gate compares a challenger against a fresh
# holdout, and a holdout an hour wide would swap models on sampling noise.
BAMA_TRAIN_EVERY=86400
BAMA_TRAIN_DELAY=600

# --- ML and backups -------------------------------------------------------
# Where trained artifacts are written and read. Exactly one process may write
# here; every other service mounts the same volume read-only.
ML_ARTIFACT_DIR=data/ml
# Where check_backup_freshness looks. Empty means "this environment has no
# backups", which is the truth on a laptop and must not read as a failure.
BAMA_BACKUP_DIR=

# --- Optional Telegram deal notifier --------------------------------------
# The chat id lives in NotifierSettings (editable from the deal board); the
# token is a secret and stays here. Empty disables sending. A key that is
# simply absent from .env.production is not a compose error — it becomes
# "" and the container looks configured. Check the value's length.
BAMA_TELEGRAM_TOKEN=

# --- Frontend (read by Vite at build/dev time, not by Django) -------------
# Where the SPA sends /api calls. Empty means same-origin, which is what the
# Vite dev proxy and the production nginx both provide.
VITE_API_BASE=
# What the Vite dev proxy forwards /api to.
VITE_API_TARGET=http://localhost:8001
# Origin named in the canonical link, the sitemap and robots.txt. Empty falls
# back to the deployed host.
VITE_SITE_URL=
