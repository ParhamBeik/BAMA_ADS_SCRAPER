# Django
SECRET_KEY=replace-with-a-long-random-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=bama_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-side DSN for the compose Postgres. Port 5433, not 5432: a native
# PostgreSQL install usually already owns 5432, and pointing here at 5432 would
# make host-run manage.py commands hit that unrelated server instead of this
# stack's database. There is only one bama_saas database — this one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bama_saas
# Host port docker-compose publishes Postgres on; must match the port above.
# The container-internal port is always 5432, which is what compose passes to
# the django and worker services.
POSTGRES_HOST_PORT=5433

# Admin job trigger key (X-Admin-Key header)
ADMIN_API_KEY=change-me

# Bama scraper / data
BAMA_MAX_ADS=50000
BAMA_PAGE_PAUSE=0.8
BAMA_REQUEST_TIMEOUT=20
BAMA_COOKIE=
# Absolute paths inside the container; docker-compose mounts ./data read-only at /data
BAMA_SCRAPED_DATA_ROOT=/data
BAMA_HISTORY_DB_PATH=/data/bama.db
# STALE_AFTER_DAYS is gone: ad removal is now proven by sweep coverage
# (absent from the last 2 completed sweeps), not guessed from elapsed time.

# Login accounts. Dev/local: `manage.py ensure_dev_admin` (DEBUG only), admin
# only. Prod: `manage.py ensure_seed_users` (see docker-compose.prod.yml),
# both accounts — admin is full access, demo is read-only (see
# apps/accounts/permissions.ReadOnlyForDemo). Use long random passwords in
# .env.production; the values below are dev-only placeholders.
DEV_ADMIN_EMAIL=admin@bama.local
DEV_ADMIN_PASSWORD=LocalOps-2026
DEMO_USER_EMAIL=demo@bama.local
DEMO_USER_PASSWORD=LocalOps-2026-demo

# pgAdmin (dev)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
