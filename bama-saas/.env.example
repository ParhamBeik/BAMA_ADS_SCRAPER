# Django
SECRET_KEY=replace-with-a-long-random-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=bama_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bama_saas

# Admin job trigger key (X-Admin-Key header)
ADMIN_API_KEY=change-me

# Bama scraper / data
BAMA_MAX_ADS=50000
BAMA_PAGE_PAUSE=0.8
BAMA_REQUEST_TIMEOUT=20
BAMA_COOKIE=
# Absolute paths inside the container; docker-compose mounts bama-scraper/data read-only at /data
BAMA_SCRAPED_DATA_ROOT=/data
BAMA_HISTORY_DB_PATH=/data/history.db
STALE_AFTER_DAYS=14

# pgAdmin (dev)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
