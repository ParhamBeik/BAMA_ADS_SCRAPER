# Copy to .env. Compose reads it; so does deploy/worker.sh under host cron.

# --- Django ---------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret-key
# Unset (or anything other than 1) means the hardened profile: HTTPS redirect,
# HSTS, throttles, login required. A deployed process must never fail open.
DJANGO_DEBUG=1
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=bama_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-side DSN. Port 5433, not 5432: a native PostgreSQL install usually owns
# 5432, and pointing here at it would make host-run manage.py commands hit that
# unrelated server. There is one bama_saas database — this one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bama_saas
# Host port compose publishes Postgres on; must match the port above. The
# container-internal port is always 5432.
POSTGRES_HOST_PORT=5433
FRONTEND_HOST_PORT=5174

# --- Crawler --------------------------------------------------------------
BAMA_MAX_ADS=50000
# 1.5s, not 0.8s: bama.ir answered 503 to 55 runs over 39 days. A slower crawl
# that completes is worth more than a fast one whose coverage cannot be proven.
BAMA_PAGE_PAUSE=1.5
BAMA_REQUEST_TIMEOUT=20
BAMA_COOKIE=
BAMA_WORKER_FETCH_ADS=500
BAMA_COVERAGE_CHUNK_PAGES=120
# Episodes that started before this date have untrustworthy end dates and are
# excluded from survival analysis. Set it to the date rolling coverage went live.
BAMA_EPISODE_CLEAN_START=2026-08-14

# --- Worker intervals (seconds) -------------------------------------------
BAMA_HOT_EVERY=900
BAMA_COVERAGE_EVERY=600
BAMA_WARM_EVERY=1800
BAMA_MAINTENANCE_EVERY=21600

# --- Seeded logins --------------------------------------------------------
# Created or updated on every startup by `manage.py ensure_seed_users`. The
# admin has Control + Django-admin access; the demo user does not. Use long
# random values in .env.production — these are dev placeholders.
DEV_ADMIN_EMAIL=admin@bama.local
DEV_ADMIN_PASSWORD=LocalOps-2026
DEMO_USER_EMAIL=demo@bama.local
DEMO_USER_PASSWORD=LocalOps-2026-demo

# --- Optional Telegram deal notifier --------------------------------------
# The chat id lives in NotifierSettings (editable from the deal board); the
# token is a secret and stays here. Empty disables sending.
BAMA_TELEGRAM_TOKEN=
