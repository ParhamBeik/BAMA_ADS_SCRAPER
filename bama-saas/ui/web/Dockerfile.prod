FROM node:24-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
# Plain `npm ci`, the same command CI runs. It used to carry
# `--legacy-peer-deps` for a conflict between openapi-typescript and the pinned
# typescript; neither the package nor the conflict is in the lockfile any more,
# so the flag was doing one thing only — letting the image that ships resolve
# peers differently from the tree CI type-checked and built.
RUN npm ci
COPY . .
# The public origin is baked in because the sitemap and robots.txt are static
# files in the bundle -- there is no runtime
# env lookup. Require a trusted HTTPS origin rather than ship localhost or HTTP.
ARG VITE_SITE_URL=""
ENV VITE_SITE_URL=$VITE_SITE_URL
RUN case "$VITE_SITE_URL" in https://?*) npm run build ;; \
    *) echo "VITE_SITE_URL must be an HTTPS origin" >&2; exit 1 ;; esac
# Precompress every text asset once, here, instead of on every request from
# every visitor. `gzip_static` in nginx.conf picks these up automatically.
RUN find dist -type f \
        \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' \
           -o -name '*.json' -o -name '*.webmanifest' -o -name '*.txt' \) \
        -exec gzip -9 -k -f {} \;

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/conf.d/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
