FROM node:24-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
# Plain `npm ci`, the same command CI runs. It used to carry
# `--legacy-peer-deps` for a conflict between openapi-typescript and the pinned
# typescript; neither the package nor the conflict is in the lockfile any more,
# so the flag was doing one thing only — letting the image that ships resolve
# peers differently from the tree CI type-checked and built.
RUN npm ci
COPY . .
# The public origin, baked in at build time because the canonical link, the
# sitemap and robots.txt are static files in the bundle -- there is no runtime
# to read an env var. Unset is fine: vite.config.ts treats the empty string the
# Docker ARG leaves behind as "not provided" and falls back to the deployed
# host. Without this ARG the override was unreachable from the only build that
# produces the deployed artifact.
ARG VITE_SITE_URL=""
ENV VITE_SITE_URL=$VITE_SITE_URL
RUN npm run build
# Precompress every text asset once, here, instead of on every request from
# every visitor. `gzip_static` in nginx.conf picks these up automatically.
RUN find dist -type f \
        \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' \
           -o -name '*.json' -o -name '*.webmanifest' -o -name '*.txt' \) \
        -exec gzip -9 -k -f {} \;

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/conf.d/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
