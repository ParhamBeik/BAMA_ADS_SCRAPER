# Copy to .env.production on the VPS. Compose refuses to start if the
# required keys below are missing (`:?` in docker-compose.prod.yml).
# Never commit the filled file.
# Verify the public host and trusted HTTPS origin before deployment.

# --- Django ---------------------------------------------------------------
SECRET_KEY=
ALLOWED_HOSTS=bama.parhambm.ir,localhost,127.0.0.1,backend
CORS_ORIGINS=https://bama.parhambm.ir
# Same-origin behind Caddy; set this if the API is ever on a different host.
CSRF_TRUSTED_ORIGINS=https://bama.parhambm.ir
# Unset. Hardened profile is the default; a missing DJANGO_DEBUG must not fail open.
# Proxies in front of Django: Caddy, then the frontend nginx. This is what makes
# the login/register/password throttles bucket on the caller's real address
# instead of on a header the caller writes. Only change it if the chain changes.
NUM_PROXIES=2
# Auth rate limits, per resolved client IP. Leave these unset to take the
# defaults in docker-compose.prod.yml (30/min register, 60/min login), which are
# sized so that a group of people behind one office NAT can all sign up — they
# share a single public address, and the tighter 5/min default in settings.py
# made the sixth signup in a minute look like a ban. Set them here only to go
# *tighter* than that, and never to an empty value: an env var that is present
# and empty beats the default and hands DRF an unparseable rate.
# THROTTLE_REGISTER=30/min
# THROTTLE_LOGIN=60/min
# THROTTLE_ANON=300/min

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=bama_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Redis / ML -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=512mb
ML_CPUS=1.5
ML_MEMORY=1500m

# --- Crawler --------------------------------------------------------------
BAMA_MAX_ADS=50000
BAMA_PAGE_PAUSE=1.5
BAMA_REQUEST_TIMEOUT=20
BAMA_COOKIE=
BAMA_EPISODE_CLEAN_START=2026-08-14

# --- Optional Telegram ----------------------------------------------------
# Empty disables sending. A key that is present but blank is not a compose error.
BAMA_TELEGRAM_TOKEN=

# --- Frontend build -------------------------------------------------------
# Origin named in the sitemap and robots.txt. Required by the production image.
VITE_SITE_URL=https://bama.parhambm.ir
